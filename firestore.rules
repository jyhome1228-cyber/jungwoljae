rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    // Member profile data remains private even though admin.html itself is login-free.
    match /users/{uid} {
      allow create, update, delete: if isOwner(uid);
      allow read: if isOwner(uid) || isAdmin();

      match /readings/{readingId} {
        allow create, update, delete: if isOwner(uid);
        allow read: if isOwner(uid) || isAdmin();
      }
    }

    match /member_usage/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
                            && request.resource.data.keys().hasOnly(['total', 'services', 'lastUsedAt']);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn() || isAdmin();
      allow list: if isAdmin();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Reviews are public and may be submitted without an account.
    // Public creation is restricted to the exact anonymous review shape below.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
                      'uid', 'authorLabel', 'service', 'rating', 'content', 'status', 'createdAt'
                    ])
                    && request.resource.data.authorLabel == '익명 사용자'
                    && request.resource.data.status == 'published'
                    && request.resource.data.service in [
                      '오행 분석', '오늘의 운세', '내일의 운세', '연애와 인연', '궁합',
                      '일과 재물', '정월도감', '정월부적', '행운의 숫자', '중요한 날', '이사 택일'
                    ]
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.content.size() >= 10
                    && request.resource.data.content.size() <= 500
                    && request.resource.data.createdAt == request.time
                    && (
                      (signedIn() && request.resource.data.uid == request.auth.uid)
                      || (!signedIn() && request.resource.data.uid == null)
                    );
      allow update: if false;
      allow delete: if isAdmin();
    }

    // A result page may append one privacy-restricted reading event after the user submitted
    // a reading form. The public client can create only this narrow shape; only admins can read it.
    match /reading_events/{eventId} {
      allow create: if request.resource.data.keys().hasOnly([
                      'service', 'serviceLabel', 'name', 'birthDate', 'birthTime',
                      'birthTimeUnknown', 'calendarType', 'gender', 'city', 'focus',
                      'domain', 'situation', 'blockers', 'partnerName', 'partnerBirthDate',
                      'uid', 'createdAt'
                    ])
                    && (
                      request.resource.data.get('service', '') == 'saju'
                      || request.resource.data.get('service', '') == 'ohaeng'
                      || request.resource.data.get('service', '') == 'fortune'
                      || request.resource.data.get('service', '') == 'relationship'
                      || request.resource.data.get('service', '') == 'compatibility'
                      || request.resource.data.get('service', '') == 'work-money'
                      || request.resource.data.get('service', '') == 'guide'
                    )
                    && request.resource.data.serviceLabel.size() <= 40
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.birthDate.size() <= 20
                    && request.resource.data.birthTime.size() <= 20
                    && request.resource.data.calendarType.size() <= 20
                    && request.resource.data.gender.size() <= 20
                    && request.resource.data.city.size() <= 120
                    && request.resource.data.focus.size() <= 4
                    && request.resource.data.blockers.size() <= 4
                    && request.resource.data.domain.size() <= 120
                    && request.resource.data.situation.size() <= 120
                    && request.resource.data.partnerName.size() <= 120
                    && request.resource.data.partnerBirthDate.size() <= 20
                    && request.resource.data.createdAt == request.time
                    && (
                      (signedIn() && request.resource.data.uid == request.auth.uid)
                      || (!signedIn() && request.resource.data.uid == null)
                    );
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Public, aggregate-only operational analytics used by the login-free dashboard.
    // No account identity, IP, location, referrer, user-agent or fingerprint is stored here.
    match /analytics_daily/{dateKey} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['pageViews', 'updatedAt'])
                    && request.resource.data.pageViews == 1;
      allow update: if request.resource.data.keys().hasOnly(['pageViews', 'updatedAt'])
                    && request.resource.data.pageViews == resource.data.pageViews + 1;
      allow delete: if false;

      match /visitors/{visitorId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['visitorId', 'createdAt'])
                      && request.resource.data.visitorId == visitorId;
        allow update, delete: if false;
      }

      match /pages/{pageId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['path', 'label', 'pageViews', 'updatedAt'])
                      && request.resource.data.pageViews == 1;
        allow update: if request.resource.data.keys().hasOnly(['path', 'label', 'pageViews', 'updatedAt'])
                      && request.resource.data.path == resource.data.path
                      && request.resource.data.label == resource.data.label
                      && request.resource.data.pageViews == resource.data.pageViews + 1;
        allow delete: if false;
      }
    }
  }
}
